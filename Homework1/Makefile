CC=mpicc
CFLAGS=-Wall -Wextra -pedantic

all: problem1 problem2 problem3 problem4 problem5 problem6 problemg1

problem1: problem1.c problem1main.c problem1.h
	$(CC) $(CFLAGS) problem1.c problem1main.c -o problem1

.PHONY: runp1
runp1:
	mpirun -np 4 ./problem1

# == Begin code generated by ChatGPT ==
problem2: problem2main.c
	$(CC) $(CFLAGS) -DN=5 problem2main.c -o problem2

.PHONY: runp2
runp2:
	mpirun -np 4 ./problem2
# == End LLM-generated code ==

problem3: problem3.c problem3main.c problem3.h
	$(CC) $(CFLAGS) problem3.c problem3main.c -o problem3

.PHONY: runp3
runp3:
	mpirun -np 2 ./problem3

# == Begin code generated by ChatGPT ==
problem4: problem4main.c
	$(CC) $(CFLAGS) problem4main.c -o problem4

.PHONY: runp4
runp4:
	mpirun -np 4 ./problem4 100000
# == End LLM-generated code ==

problem5: problem5main.c
	$(CC) $(CFLAGS) problem5main.c -o problem5

.PHONY: runp5
runp5:
	mpirun -np 8 ./problem5

problem6: problem6main.c
	$(CC) $(CFLAGS) problem6main.c -o problem6

.PHONY: runp6
runp6:
	mpirun -np 8 ./problem6

problemg1: problemg1main.c problemg1.c problemg1.h Terminal.c Terminal.h
	$(CC) $(CFLAGS) problemg1main.c problemg1.c Terminal.c -o problemg1

.PHONY: runpg1
runpg1:
	mpirun -np 8 ./problemg1

.PHONY: clean
clean:
	rm ./problem1
